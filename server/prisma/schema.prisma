generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id           String  @id
  date         String
  time         String?
  type         String
  category     String
  subcategory  String?
  vendor       String
  amount       Float
  currency     String?
  source       String?
  memo         String?
  hash         String? @unique
  isVerified   Boolean @default(true)
  isDuplicate  Boolean @default(false)
  isDeleted    Boolean @default(false)
  member              String       @default("효")
}

model ImportBatch {
  id        String      @id @default(uuid())
  filename  String?
  totalRows Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  rows      ImportRow[]
}

model ImportRow {
  id                  String       @id @default(uuid())
  batchId             String?
  batch               ImportBatch? @relation(fields: [batchId], references: [id])
  rowNumber           Int?
  status              String
  invalidReason       String?
  sourceTransactionId String?      @unique
  date                String
  time                String?
  type                String
  category            String
  subcategory         String?
  vendor              String
  amount              Float
  currency            String?
  source              String?
  memo                String?
  member              String       @default("미지정")
  rawData             Json?
  committedAt         DateTime?
  transactionId       String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt

  @@index([status])
  @@index([batchId])
  @@index([createdAt])
}

model CategoryRule {
  id                String @id
  keyword           String @unique
  assigned_category String
}

model Category {
  id        String  @id
  name      String  @unique
  groupName String  @default("기타")
  isDeleted Boolean @default(false)
}

model CategoryGroupRule {
  id                String @id
  categoryName      String @unique
  assignedGroup     String
}

model PaymentRule {
  id          String @id
  paymentType String // 'card' or 'transfer'
  keyword     String @unique
}

model Session {
  sid    String   @id @unique
  sess   Json
  expire DateTime

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model RecurringTransaction {
  id           String @id
  vendor       String
  amount       Float
  category     String
  type         String @default("expense")
  day_of_month Int
}

model Asset {
  id        String   @id
  name      String   @unique
  type      String   // 'cash', 'bank', 'stock', 'realestate', 'liability', etc.
  balance   Float    @default(0)
  isDeleted Boolean  @default(false)
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AssetHistory {
  id        String   @id @default(uuid())
  yearMonth String   // "2026-05" 형식
  totalAssets Float
  totalLiabilities Float
  netAssets Float
  createdAt DateTime @default(now())

  @@unique([yearMonth])
}

model IgnoredRule {
  id      String @id @default(uuid())
  keyword String @unique
}

model ExclusionRule {
  id      String @id @default(uuid())
  keyword String @unique
}

model DeletedHash {
  hash      String   @id
  createdAt DateTime @default(now())
}

model Auth {
  role         String @id // 'admin' or 'viewer'
  passwordHash String
}

model AuditLog {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  beforeData Json?
  afterData  Json?
  actorRole  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model ReviewRequest {
  id         String   @id @default(uuid())
  targetType String
  targetId   String?
  type       String   @default("question")
  title      String
  body       String
  status     String   @default("open")
  authorRole String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([targetType, targetId])
  @@index([status])
  @@index([createdAt])
}

model Notice {
  id           String   @id @default(uuid())
  title        String
  body         String
  isActive     Boolean  @default(true)
  readByAdmin  Boolean  @default(false)
  readByViewer Boolean  @default(false)
  authorRole   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([isActive])
  @@index([createdAt])
}
