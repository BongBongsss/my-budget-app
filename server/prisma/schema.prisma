generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id               String  @id
  date             String
  amount           Float
  vendor           String
  category         String
  type             String
  source           String?
  hash             String? @unique
  memo             String?
  currency         String?
  subcategory      String?
  time             String?
  isVerified       Boolean @default(true)
  isDuplicate      Boolean @default(false)
  member           String  @default("효")
  isDeleted        Boolean @default(false)
  isManualCategory Boolean @default(false)
}

model ImportBatch {
  id        String      @id @default(uuid())
  filename  String?
  totalRows Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt
  rows      ImportRow[]
}

model ImportRow {
  id                  String       @id @default(uuid())
  batchId             String?
  rowNumber           Int?
  status              String
  invalidReason       String?
  sourceTransactionId String?      @unique
  date                String
  time                String?
  type                String
  category            String
  subcategory         String?
  vendor              String
  amount              Float
  currency            String?
  source              String?
  memo                String?
  member              String       @default("미지정")
  rawData             Json?
  committedAt         DateTime?
  transactionId       String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt
  isManualCategory    Boolean      @default(false)
  batch               ImportBatch? @relation(fields: [batchId], references: [id])

  @@index([status])
  @@index([batchId])
  @@index([createdAt])
}

model CategoryRule {
  id                String @id
  keyword           String @unique
  assigned_category String
}

model Category {
  id        String  @id
  name      String  @unique
  groupName String  @default("기타")
  isDeleted Boolean @default(false)
}

model CategoryGroupRule {
  id            String @id
  categoryName  String @unique
  assignedGroup String
}

model PaymentRule {
  id          String @id
  paymentType String
  keyword     String @unique
}

model Session {
  sid    String   @id @unique
  sess   Json
  expire DateTime

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model RecurringTransaction {
  id           String   @id
  vendor       String
  amount       Float
  category     String
  type         String   @default("expense")
  day_of_month Int
  member       String   @default("shared")
  isActive     Boolean  @default(true)
  isVariable   Boolean  @default(false)
  memo         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Asset {
  id        String   @id
  name      String   @unique
  type      String
  balance   Float    @default(0)
  memo      String?
  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
  isDeleted Boolean  @default(false)
  member    String   @default("공동")
}

model AssetType {
  id          String   @id
  name        String   @unique
  isLiability Boolean  @default(false)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model AssetHistory {
  id               String   @id @default(uuid())
  yearMonth        String   @unique
  totalAssets      Float
  totalLiabilities Float
  netAssets        Float
  createdAt        DateTime @default(now())
}

model IgnoredRule {
  id      String @id @default(uuid())
  keyword String @unique
}

model DeferredRuleSuggestion {
  id            String   @id @default(uuid())
  vendorKey     String   @unique
  deferredUntil DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([deferredUntil])
}

model IgnoredRecurringSuggestion {
  id        String   @id @default(uuid())
  vendorKey String   @unique
  createdAt DateTime @default(now())
}

model DeferredRecurringSuggestion {
  id            String   @id @default(uuid())
  vendorKey     String   @unique
  deferredUntil DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([deferredUntil])
}

model ExclusionRule {
  id      String @id @default(uuid())
  keyword String @unique
}

model DeletedHash {
  hash      String   @id
  createdAt DateTime @default(now())
}

model Auth {
  role         String @id
  passwordHash String
}

model AuditLog {
  id         String    @id @default(uuid())
  entityType String
  entityId   String
  action     String
  beforeData Json?
  afterData  Json?
  actorRole  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt
  batchId    String?
  restoredAt DateTime?

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([batchId])
  @@index([restoredAt])
}

model ReviewRequest {
  id         String   @id @default(uuid())
  targetType String
  targetId   String?
  type       String   @default("question")
  title      String
  body       String
  status     String   @default("open")
  authorRole String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([targetType, targetId])
  @@index([status])
  @@index([createdAt])
}

model Notice {
  id           String   @id @default(uuid())
  title        String
  body         String
  isActive     Boolean  @default(true)
  readByAdmin  Boolean  @default(false)
  readByViewer Boolean  @default(false)
  authorRole   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([isActive])
  @@index([createdAt])
}

model ChartStatisticsSettings {
  id             String   @id
  excludedGroups Json     @default("{\"income\": [], \"expense\": []}")
  updatedAt      DateTime @default(now())
}

model RecurringAlias {
  id          String   @id
  recurringId String
  vendorKey   String   @unique
  label       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([recurringId])
}

model RecurringMatchConfirmation {
  id            String   @id
  recurringId   String
  transactionId String   @unique
  yearMonth     String
  createdAt     DateTime @default(now())

  @@unique([recurringId, yearMonth])
  @@index([yearMonth])
}
