{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx -y node@20 ../node_modules/ts-node/dist/bin.js src/index.ts",
    "dev:system-node": "ts-node src/index.ts",
    "backup:local": "npx -y node@20 ../node_modules/ts-node/dist/bin.js src/scripts/createLocalBackup.ts",
    "backup:verify": "npx -y node@20 ../node_modules/ts-node/dist/bin.js src/scripts/verifyLocalBackup.ts",
    "restore:local": "npx -y node@20 ../node_modules/ts-node/dist/bin.js src/scripts/restoreLocalBackup.ts",
    "test": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.0.0",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "papaparse": "^5.5.3",
    "read-excel-file": "^9.3.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.7.0",
    "@types/node-cron": "^3.0.11",
    "@types/papaparse": "^5.5.2",
    "prisma": "6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
